        {
          "id": "4bd0120d-c1fd-4875-8e01-c8fea71d19c2",
          "name": "Get a list of disclosures",
          "request": {
            "name": "Get a list of disclosures",
            "description": {
              "content": "Returns a list of the disclosures in your account matching the given filters.\n\nRequired API key permissions: `DataLeaks` (select when creating API key in Account Settings)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataleaks",
                "disclosures"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "min_time",
                  "value": "<dateTime>",
                  "description": "The minimum (non-inclusive) timestamp of a disclosure (RFC 3339 format)."
                },
                {
                  "disabled": false,
                  "key": "max_time",
                  "value": "<dateTime>",
                  "description": "The maximum (non-inclusive) timestamp of a disclosure (RFC 3339 format)."
                },
                {
                  "disabled": false,
                  "key": "statuses",
                  "value": "<string>",
                  "description": "A comma-delimited list of statuses that disclosures should match."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "A comma-delimited list of IDs that disclosures should match."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
