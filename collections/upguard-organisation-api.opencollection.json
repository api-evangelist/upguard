{
  "opencollection": "1.0.0",
  "info": {
    "name": "UpGuard CyberRisk breaches organisation API",
    "version": "1.13.2"
  },
  "items": [
    {
      "info": {
        "name": "organisation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the current organisation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/organisation"
          },
          "docs": "Returns the information of the organisation associated with the API key used for the request.\n\nRequired API key permissions: `Platform` (select when creating API key in Account Settings)"
        }
      ]
    }
  ],
  "bundled": true
}