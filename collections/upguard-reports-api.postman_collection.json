        {
          "id": "99492756-82d8-4125-9efd-9a4b6c1f4536",
          "name": "Get the status of an exported report",
          "request": {
            "name": "Get the status of an exported report",
            "description": {
              "content": "Poll this endpoint for the status of a report export you have queued. When complete, you will receive a download URL.\n\nRequired API key permissions: `Platform` (select when creating API key in Account Settings)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "queued_report_id",
                  "value": "<string>",
                  "description": "(Required) The queued_report_id returned from the /reports/queue endpoint."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "99e4c732-fd71-4e68-b681-9ec800c68125",
